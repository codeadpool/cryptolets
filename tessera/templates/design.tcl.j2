set design_name {{ design_name }}
set design_build_dir {{ design_build_dir }}
# Stop after schedule, so the latency can decide combinational or sequential
set comb_chk {{ comb_chk | tcl }}
set top_class {{ top_class }}
# Whether the generated headers stand in for their deps
set uses_blackboxes {{ uses_blackboxes | tcl }}
# This kernel's sweep directives, per Catapult state, as name value pairs
{% for state, pairs in catapult_directives.items() -%}
set catapult_directives({{ state }}) { {{- pairs -}} }
{% endfor %}{# Per-kernel keys only name the build; their values reach Catapult above #}
{% for param, value in design.items() if not param.startswith(("deps.", "catapult.")) -%}
set {{ param }} {{ value | tcl }}
{% endfor %}
{% for key, value in tech.items() -%}
set tech_{{ key }} {{ value | tcl }}
{% endfor %}
